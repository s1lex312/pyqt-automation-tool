/* ===== СОВРЕМЕННЫЙ UI СТИЛЬ (Uber-подобный) ===== */

/* Главное окно */
QWidget {
    background-color: #ffffff;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: bold;
}

QMainWindow {
    background-color: #ffffff;
    border: none;
}

/* Кнопки - светлосерые как в Uber */
QPushButton {
    background-color: #f8f9fa;
    color: #000000;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 8px 12px;
    font-weight: bold;
    font-size: 14px;
    margin: 1px;
    min-height: 15px;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

QPushButton:hover {
    background-color: #e9ecef;
    border-color: #d0d0d0;
}

QPushButton:pressed {
    background-color: #dee2e6;
}

QPushButton:disabled {
    background-color: #f8f9fa;
    color: #9e9e9e;
    border-color: #e0e0e0;
}

/* Специальные стили кнопок */
QPushButton[class="primary"] {
    background-color: #000000;
    color: white;
    border: 1px solid #000000;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

QPushButton[class="primary"]:hover {
    background-color: #333333;
    border-color: #333333;
}

QPushButton[class="success"] {
    background-color: #00b14f;
    color: white;
    border: 1px solid #00b14f;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

QPushButton[class="danger"] {
    background-color: #d8544e;
    color: white;
    border: 1px solid #ff3b30;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

QPushButton[class="danger"]:hover {
    background-color: #d66d67;
    color: white;
    border: 1px solid #ff3b30;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

QPushButton[class="warning"] {
    background-color: #ff9500;
    color: white;
    border: 1px solid #ff9500;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

QPushButton[class="outline"] {
    background-color: transparent;
    border: 1px solid #000000;
    color: #000000;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

/* Текстовые поля - компактные отступы */
QLineEdit, QTextEdit, QPlainTextEdit {
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 6px 10px;
    background-color: #ffffff;
    color: #000000;
    font-size: 14px;
    selection-background-color: #000000;
    selection-color: white;
    
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: bold;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #000000;
    background-color: white;
}

QLineEdit[error="true"] {
    border-color: #ff3b30;
}

/* Выпадающие списки */
QComboBox {
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 6px 10px;
    background-color: #ffffff;
    color: #000000;
    font-size: 14px;
    min-height: 20px;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: bold;
}

QComboBox:focus {
    border-color: #000000;
    background-color: white;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    border-left: none;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4px solid #000000;
    width: 0px;
    height: 0px;
}

QComboBox QAbstractItemView {
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    background-color: white;
    selection-background-color: #f8f9fa;
    selection-color: #000000;
    padding: 4px 0px;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: bold;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border: none;
    font-size: 14px;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: bold;
}

/* Чекбоксы и радиокнопки */
QCheckBox, QRadioButton {
    color: #000000;
    font-size: 14px;
    spacing: 8px;
    padding: 2px;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: bold;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator:unchecked {
    border: 2px solid #e0e0e0;
    border-radius: 4px;
    background-color: white;
}

QCheckBox::indicator:checked {
    border: 2px solid #000000;
    border-radius: 4px;
    background-color: #000000;
}

QRadioButton::indicator:unchecked {
    border: 2px solid #e0e0e0;
    border-radius: 9px;
    background-color: white;
}

QRadioButton::indicator:checked {
    border: 2px solid #000000;
    border-radius: 9px;
    background-color: #000000;
}

/* Полосы прокрутки */
QScrollBar:vertical {
    border: none;
    background: #f8f9fa;
    width: 6px;
    margin: 0px;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: #c8c8c8;
    border-radius: 3px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #a0a0a0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Вкладки */
QTabWidget::pane {
    border: none;
    background-color: white;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

QTabBar::tab {
    background-color: transparent;
    color: #666666;
    padding: 8px 12px;
    border: none;
    border-bottom: 2px solid transparent;
    font-weight: bold;
    font-size: 14px;
    min-height: 20px;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

QTabBar::tab:selected {
    color: #000000;
    border-bottom: 2px solid #000000;
}

QTabBar::tab:hover:!selected {
    background-color: #f8f9fa;
    color: #000000;
}

/* Меню */
QMenuBar {
    background-color: white;
    color: #000000;
    border-bottom: 1px solid #f0f0f0;
    padding: 4px;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: bold;
}

QMenuBar::item {
    padding: 6px 12px;
    background-color: transparent;
    border-radius: 4px;
    font-size: 14px;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: bold;
}

QMenuBar::item:selected {
    background-color: #f8f9fa;
}

QMenu {
    background-color: white;
    border: 2px solid #f0f0f0;
    border-radius: 8px;
    padding: 6px;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: bold;
}

QMenu::item {
    padding: 8px 16px;
    border-radius: 4px;
    font-size: 14px;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: bold;
}

QMenu::item:selected {
    background-color: #f8f9fa;
}

QMenu::separator {
    height: 1px;
    background-color: #f0f0f0;
    margin: 4px 0px;
}

/* Списки и таблицы */
QListWidget, QTreeWidget, QTableView {
    background-color: white;
    border: 1px solid lightgray;
    border-radius: 0px;
    alternate-background-color: #f8f9fa;
    outline: none;
    font-size: 14px;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: bold;
}

QListWidget::item, QTreeWidget::item {
    border-radius: 2px;
    border-bottom: 1px solid #f0f0f0;
    min-height: 15px;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: bold;
}

QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #dee2e6;
    border-radius: 2px;
    color: #000000;
}

QHeaderView::section {
    background-color: white;
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid #f0f0f0;
    font-weight: bold;
    color: #000000;
    font-size: 14px;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

/* Прогресс-бар */
QProgressBar {
    border: none;
    border-radius: 4px;
    text-align: center;
    background-color: #f0f0f0;
    color: #000000;
    font-weight: bold;
    font-size: 12px;
    padding: 2px;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

QProgressBar::chunk {
    background-color: #000000;
    border-radius: 4px;
}

/* Групповые панели */
QGroupBox {
    font-weight: bold;
    border: 1px solid #f0f0f0;
    border-radius: 8px;
    margin-top: 1ex;
    padding-top: 12px;
    background-color: white;
    color: #000000;
    font-size: 14px;
    padding: 4px;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    background-color: white;
    margin-left: 8px;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: bold;
}

/* Слайдеры */
QSlider::groove:horizontal {
    border: none;
    height: 3px;
    background: #f0f0f0;
    border-radius: 2px;
    margin: 2px 0;
}

QSlider::handle:horizontal {
    background: #000000;
    border: none;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

/* Тултипы */
QToolTip {
    background-color: #000000;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 12px;
    opacity: 240;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: bold;
}

/* Метки */
QLabel {
    color: #000000;
    font-size: 14px;
    padding: 2px;
    margin: 0px;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: bold;
}

QLabel[class="title"] {
    font-size: 18px;
    font-weight: bold;
    color: #000000;
    padding: 2px;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

QLabel[class="subtitle"] {
    font-size: 14px;
    font-weight: bold;
    color: #666666;
    padding: 2px;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

QLabel[class="caption"] {
    font-size: 12px;
    font-weight: bold;
    color: #666666;
    padding: 1px;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

/* Карточки (аналог Uber-карточек) */
QFrame[class="card"] {
    background-color: white;
    border: 1px solid #f0f0f0;
    border-radius: 8px;
    padding: 2px;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

QFrame[class="card"]:hover {
    border-color: #e0e0e0;
}

/* Компактные контейнеры */
QWidget[class="compact"] {
    padding: 2px;
    margin: 0px;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

QWidget[class="spacious"] {
    padding: 8px;
    margin: 2px;
    font-family: "Uber Move Bold", "Uber Move", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}